# Copy to .env (Docker Compose reads this automatically)

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optional but recommended for backend server-to-server auth calls
SUPABASE_SERVICE_ROLE_KEY=

# Frontend URL (for password reset redirects)
FRONTEND_URL=http://localhost:3000

# Supabase Postgres (Database -> Connection string)
# Example: postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# App encryption key (32 bytes recommended)
AJTRADE_DATA_KEY=replace-with-secure-32-byte-key

# Dev flags
AJTRADE_DEV_DISABLE_SECURE_COOKIE=1
AJTRADE_DEV_RETURN_TOKENS=1

# Feature #8: Notification System (Email is the default channel; Discord webhooks are added per member in the app)
# Any SMTP provider works, e.g. Gmail (smtp.gmail.com:587 + an App Password), Outlook, Resend, SendGrid, Mailgun.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address shown to members (defaults to SMTP_USERNAME)
SMTP_FROM=
# starttls (port 587, default) | ssl (port 465) | none
SMTP_SECURITY=starttls
# Optional tuning (defaults shown)
# AJTRADE_NOTIFY_POLL_SECONDS=15
# AJTRADE_NOTIFY_SEVERE_HEADLINE_SCORE=-0.75
# AJTRADE_NOTIFY_BEARISH_SENTIMENT=-0.35
# AJTRADE_NOTIFY_SENTIMENT_SHOCK_DROP=0.6
# AJTRADE_NOTIFY_PRICE_SHOCK_SIGMA=3
# AJTRADE_NOTIFY_PRICE_SHOCK_MIN_PCT=5
